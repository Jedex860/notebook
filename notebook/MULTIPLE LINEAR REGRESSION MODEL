# Calculate residuals and create a Q-Q plot

### 
# Import necessary libraries
# Import pandas as pd
# Import statsmodels.api as sm
# Import matplotlib.pyplot as plt

# Define the dataset
data = {'TV': [120, 170, 220, 270, 320, 370, 420, 470, 520],
    'Radio': [15, 20, 25, 30, 35, 40, 45, 50, 55],
    'Social_Media': [520, 770, 1020, 1270, 1520, 1770, 2020, 2270, 2520],
    'Influential_Promotion': [1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5],
    'Sales': [1300, 1500, 1700, 1900, 2100, 2300, 2500, 2700, 2900]
}

# Load the dataset into a DataFrame
df = pd.DataFrame(data)

# Define the independent variables (X) and dependent variable (y)
X = df[['TV', 'Radio', 'Social_Media', 'Influential_Promotion']]
y = df['Sales']

# Add a constant to the independent variables
X = sm.add_constant(X)

# Fit the model
model = sm.OLS(y, X).fit()

# Get the residuals
residuals = model.resid

# Create a Q-Q plot
plt.figure(figsize=(8, 6))
sm.qqplot(residuals, line='s')
plt.title('Q-Q Plot of Residuals')
plt.show()
